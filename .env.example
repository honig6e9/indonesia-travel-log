# Supabase の Project URL（Project Settings → API）
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Publishable key（または互換の anon key）。ブラウザに出してよい公開用のキーだけを書く
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# service_role / secret key / DB パスワードは、ここにもリポジトリにも絶対に書かない

# GitHub Pages などでサブパスに置く場合のみ（例：/indonesia-travel-log/）
# VITE_BASE=/indonesia-travel-log/
