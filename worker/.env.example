# 家の PC の通訳プログラムの設定。このファイルを「.env」という名前で写し、値を入れてください。
# .env は Git に入りません。service_role キーはここ以外（アプリ・GitHub・チャット）に書かないでください。
SUPABASE_URL=https://ixmwrlpbkfojxwrasier.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ここに Supabase の service_role（または secret）キー

# 以下は変えなくてかまいません
WORKER_ID=home-pc
# AUDIO_DIR=C:\Users\あなた\IndonesiaTravelLog\interpret
WHISPER_MODEL=large-v3-turbo
PROVIDERS=claude,codex,gemini,ollama
CLAUDE_MODEL=haiku
OLLAMA_MODEL=gemma4:26b
